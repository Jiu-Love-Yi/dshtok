# EditorConfig - https://editorconfig.org
#
# C sources use four-space indentation; makefiles must use real tabs; every text
# file in the repository is UTF-8 with LF line endings, a final newline, and no
# trailing whitespace.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.cmake]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.sh]
indent_size = 2

[*.md]
# Trailing double spaces are meaningful in Markdown (line breaks).
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4
